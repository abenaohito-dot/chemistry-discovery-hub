# Chemistry Discovery Hub — Environment Variables
# Copy this file to .env and fill in your values (never commit .env)

# OpenAlex API Key (optional, recommended: free personal key gives $1/day; anonymous shares $0.10/day per IP)
# Get yours free at: https://openalex.org/settings/api
OPENALEX_API_KEY=

# NCBI API Key (optional, recommended: increases PubMed rate limit from 3->10 req/s)
# Get yours free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# CrossRef Polite Pool (optional: add your email for priority queue)
CROSSREF_EMAIL=your.email@institution.ac.jp
